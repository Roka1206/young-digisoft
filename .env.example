# Copia este archivo a .env.local y rellena los valores reales.
# .env.local nunca se sube a git (ver .gitignore).

# Obligatoria. API key de Resend (resend.com) para enviar los emails del formulario de contacto.
RESEND_API_KEY=

# Obligatoria. Email que recibe los mensajes del formulario.
CONTACT_TO_EMAIL=info@youngdigisoft.es

# Obligatoria. Remitente del email, de un dominio verificado en Resend.
CONTACT_FROM_EMAIL="Young Digisoft <info@youngdigisoft.es>"
