# Copia este archivo a .env.local y rellena los valores reales.
# .env.local nunca se sube a git (ver .gitignore).

# API key de Resend (resend.com) para enviar los emails del formulario de contacto.
RESEND_API_KEY=

# Email que recibe los mensajes del formulario. Si se deja vacío, usa el email público de src/content/site.ts.
CONTACT_TO_EMAIL=info@youngdigisoft.es

# URL pública del sitio (usada en metadata/OpenGraph, robots.txt y sitemap.xml).
# En local no hace falta; en Vercel se define con el dominio real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
